<Window x:Class="DropWheel.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource FontSans}" FontSize="{StaticResource TextXs}">
  <Border Background="{StaticResource OverlayBg}" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1"
          CornerRadius="{StaticResource RadiusLg}" Padding="10" Margin="12">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4"/></Border.Effect>
    <StackPanel Width="108">
      <Image x:Name="Thumb" Width="96" Height="96" Stretch="Uniform" Cursor="Hand" ToolTip="Drag this out to use the file"
             MouseMove="Thumb_MouseMove" AutomationProperties.Name="Drag the file out"/>
      <TextBlock x:Name="NameText" Foreground="{StaticResource OverlayText}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                 Margin="0,8,0,0" MouseLeftButtonDown="Name_MouseDown" Cursor="SizeAll" ToolTip="Drag here to move this tile"/>
      <Button Content="Close" Style="{StaticResource BtnGhost}" Height="26" Click="Close_Click" Margin="0,4,0,0"
              Foreground="{StaticResource OverlayTextMuted}"/>
    </StackPanel>
  </Border>
</Window>
