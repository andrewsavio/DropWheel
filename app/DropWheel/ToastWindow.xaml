<Window x:Class="DropWheel.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" ResizeMode="NoResize" SizeToContent="Height" Width="{StaticResource ToastWidth}"
        FontFamily="{StaticResource FontSans}" FontSize="{StaticResource TextSm}">
  <ItemsControl x:Name="List" Margin="12">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Border Background="{StaticResource Bg}" CornerRadius="{StaticResource RadiusMd}" Padding="14,12" Margin="0,0,0,8"
                BorderBrush="{StaticResource Border}" BorderThickness="1">
          <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25"/></Border.Effect>
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
            <ProgressBar Height="6" Margin="0,8" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                         IsIndeterminate="{Binding Indeterminate}" Foreground="{StaticResource Accent}" Background="{StaticResource Border}"
                         BorderThickness="0">
              <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Show in folder" Style="{StaticResource Btn}" Click="Show_Click" Margin="0,0,8,0">
                <Button.Visibility><Binding Path="CanShow"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></Button.Visibility>
              </Button>
              <Button Content="Cancel" Style="{StaticResource Btn}" Click="Close_Click">
                <Button.Visibility><Binding Path="CanCancel"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></Button.Visibility>
              </Button>
              <Button Content="Dismiss" Style="{StaticResource BtnGhost}" Click="Close_Click">
                <Button.Visibility><Binding Path="IsFailed"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></Button.Visibility>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</Window>
